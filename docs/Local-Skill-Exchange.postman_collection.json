            "url": {
              "raw": "{{baseUrl}}/skills",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "skills"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Origami\",\n  \"category\": \"Other\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Matches",
      "item": [
        {
          "name": "My mutual matches",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/matches?page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "matches"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Match with a user",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/matches/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "matches",
                "{{userId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Requests",
      "item": [
        {
          "name": "Send request",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.data && j.data.request) { pm.collectionVariables.set('requestId', j.data.request.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "requests"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"receiverId\": \"{{userId}}\",\n  \"offeredSkill\": \"Guitar\",\n  \"requestedSkill\": \"Excel\",\n  \"message\": \"Hi! Want to swap?\"\n}"
            }
          }
        },
        {
          "name": "List requests",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/requests?box=all&status=pending&page=1",
              "host": [
                "{{baseUrl}}"
