# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- MongoDB ----
# Local MongoDB (use 127.0.0.1, not "localhost", to avoid IPv6 problems on Windows):
MONGODB_URI=mongodb://127.0.0.1:27017/local_skill_exchange
# MongoDB Atlas example (replace user, password and cluster):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/local_skill_exchange?retryWrites=true&w=majority
# Separate database used ONLY by `npm test` (its name must contain "test"):
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/local_skill_exchange_test

# ---- Auth ----
# `npm run setup` generates a random value for you. Never commit the real .env file.
JWT_SECRET=replace_with_a_long_random_string_at_least_32_characters
JWT_EXPIRES_IN=7d

# ---- CORS / cookies ----
# Exact frontend origin(s), comma separated, no trailing slash.
FRONTEND_URL=http://localhost:5173
# Development: lax + false. Production with frontend and backend on different domains: none + true (HTTPS required).
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
